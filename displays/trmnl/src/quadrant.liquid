<div class="layout layout--col layout--stretch-x tz-wrap{% if tz_mode == "close" %} tz-wrap--top{% endif %}">
{%- if tz_mode == "index" %}
  <div class="tz-head">
    <span class="tz-tick tz-f20"><span class="tz-bar"></span>${{ ticker }}</span>
    <span class="tz-mono tz-f16">{{ tz_periods[0] }}</span>
  </div>
  <div>
    <div class="value value--xlarge tz-num" data-value-fit="true">{{ tz_values[0] }}</div>
    <div class="tz-mono tz-f16 tz-gap-s">{% if tz_unit != "" %}{{ tz_unit }}{% else %}{{ name }}{% endif %}</div>
  </div>
{%- elsif tz_mode == "close" %}
  <div class="tz-head tz-mb">
    <span class="tz-tick tz-f16"><span class="tz-bar"></span>The Close</span>
    <span class="tz-tick tz-f14">{{ tz_close_day }}</span>
  </div>
  <div class="tz-grid2">
    {%- for t in tz_tickers %}
    <div>
      <span class="tz-tick tz-f12">${{ t }}</span>
      <span class="tz-num tz-n20">{{ tz_values[forloop.index0] }}</span>
    </div>
    {%- endfor %}
  </div>
{%- else %}
  <div class="title">No reading yet</div>
{%- endif %}
</div>
<div class="title_bar">
  <img class="image" src="{{ tz_mark }}">
  <span class="title">Tickerz</span>
</div>
